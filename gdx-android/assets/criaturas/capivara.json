{
    "nome": "capivara",
    "vida": 10,
    "raridade": 0.3,
    "modelo": "modelos/capivara.gltf",

    "hitbox": {
        "largura": 0.6,
        "altura": 0.6,
        "profundidade": 0.6
    },

    "movimento": {
        "velo": 7.0,
        "peso": 65.0,
        "pulo": 12.0
    },
    
    "animacoes": ["andando", "fazendonada", "degustando"],

    "variaveis": {
        "sede": {
            "valor": 0,
            "min": 0,
            "max": 100
        },
        "fome": {
            "valor": 100,
            "min": 0,
            "max": 100
        }
    },

    "comportamento": [
        {
            "condicao": ["noChao", "andando"],
            "exec": {
                "recompensa": 0.05,
                "tocarAnim": "andando",
                "operacao": {
                    "variavel": "fome",
                    "operador": "-",
                    "valor": 1
                }
            }
        },
        
        {
            "condicao": ["naAgua", "andando"],
            "exec": {
                "recompensa": 0.04,
                "tocarAnim": "andando",
                "operacao": {
                    "variavel": "fome",
                    "operador": "-",
                    "valor": 5
                }
            }
        },
        
        {
            "condicao": ["noChao", "parado"],
            "exec": {
              "recompensa": 0.02,
              "tocarAnim": "fazendonada"
            }
        },
        
        {
            "condicao": ["fome", "<", 1],
            "exec": {
                "recompensa": -0.05,
                "tocarAnim": "degustando",
                "operacao": {
                   "variavel": "fome",
                   "operador": "=",
                   "valor": 100
               }
            }
        },
        
        {
            "condicao": ["sede", ">", 85],
            "exec": {
                "procurarBloco": ["agua"],
                "recompensa": -0.1
            }
        },
        {
            "condicao": ["bloco", "==", "agua"],
            "exec": {
                "operacao": {
                    "variavel": "sede",
                    "operador": "-",
                    "valor": 1
                }
            }
        },
        {
            "condicao": ["naAgua"],
            "exec": {
                "operacao": {
                    "variavel": "sede",
                    "operador": "-",
                    "valor": 2
                }
            }
        },
        {
            "condicao": ["!naAgua"],
            "exec": {
                "operacao": {
                    "variavel": "sede",
                    "operador": "+",
                    "valor": 1
                }
            }
        }
    ],

    "origem": {
        "biomas": ["rio", "costa"],
        "chance": 0.5,
        "max": 10
    }
}

